# Required: Gemini API key for AI playlists (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Spotify app client ID, for importing Spotify playlists
# (see README → Spotify). Redirect URI must match the one registered on the app.
PODCRATE_SPOTIFY_CLIENT_ID=
# PODCRATE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional: YouTube cookies, for private playlists or when downloads get 403s
# PODCRATE_YTDLP_COOKIES_FILE=~/cookies.txt
# PODCRATE_YTDLP_COOKIES_FROM_BROWSER=firefox     # or BROWSER+KEYRING, e.g. chromium+gnomekeyring

# Optional overrides (defaults shown)
# PODCRATE_LIBRARY_DIR=~/Music/podcrate
# PODCRATE_MODEL=gemini-flash-latest
# PODCRATE_IPOD_MUSIC_SUBDIR=Music
# PODCRATE_IPOD_PLAYLISTS_SUBDIR=Playlists
